# ===== TutorHub backend: variables de entorno =====
# Copie este archivo a ".env" y complete los valores. NUNCA suba el ".env" al repositorio.

NODE_ENV=development
PORT=5000

# Cadena de conexión a PostgreSQL (en Render: "Internal Database URL" o "External Database URL")
DATABASE_URL=postgres://tutor:tutor@localhost:5432/tutordb
# true cuando la base de datos exige SSL (Render externa, Neon, Supabase...)
DATABASE_SSL=false

# Clave para firmar los JWT (use una cadena larga y aleatoria)
JWT_SECRET=cambie_esta_clave_por_una_larga_y_aleatoria
# Duración del token JWT (configurable): 15m, 2h, 1d ...
JWT_EXPIRES_IN=2h

# ID de cliente de Google OAuth 2.0 (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=

# Correos (separados por coma) que se convierten en administradores al iniciar sesión
ADMIN_EMAILS=su_correo@gmail.com

# Origen(es) permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173

# Zona horaria con la que se interpretan los horarios de las tutorías
APP_TIMEZONE=America/Guatemala

# Servicio de rutas (OSRM). Si no responde se usa una estimación en línea recta.
OSRM_URL=https://router.project-osrm.org
# true: el cargo de traslado se calcula ida y vuelta; false: solo el trayecto mostrado en el mapa
TRAVEL_ROUND_TRIP=false

# Login de desarrollo (sin Google). NUNCA activar en producción.
ENABLE_DEV_LOGIN=true
