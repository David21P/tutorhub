# URL pública del backend (vacío = mismo origen / proxy de Vite en desarrollo)
VITE_API_URL=
# Client ID de OAuth 2.0 de Google (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
# Muestra el acceso de desarrollo sin Google (solo funciona si el backend tiene ENABLE_DEV_LOGIN=true)
VITE_ENABLE_DEV_LOGIN=true
